{
  "name": "devsparring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copiar-monaco.mjs && next dev",
    "dev:webpack": "node scripts/copiar-monaco.mjs && next dev --webpack",
    "build": "node scripts/copiar-monaco.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "contenido:validar": "node scripts/validar-contenido.mjs",
    "detector": "node scripts/detector-diseno.mjs",
    "capturas": "node scripts/capturas.mjs",
    "revisar": "node scripts/revisar.mjs",
    "capturas:app": "node scripts/capturas-app.mjs",
    "tipos:supabase": "npx supabase gen types typescript --project-id gbrzpvpvgxvwgbbygowf --schema public > src/lib/supabase/tipos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@internationalized/date": "^3.12.4",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
