# Copia a .env.local. Nunca se versiona.

# Supabase (Project Settings > API). Claves nuevas: publishable y secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cadena de conexión Postgres para scripts/migrar.mjs (Database > Connection string, modo session).
# La contraseña nunca pasa por el chat.
DATABASE_URL=

# Cuenta del dueño: su clave de Anthropic vive aquí, no en la base de datos.
# Solo se usa cuando el usuario con sesión es DEVSPARRING_OWNER_USER_ID.
DEVSPARRING_OWNER_USER_ID=
DEVSPARRING_OWNER_ANTHROPIC_KEY=
